AUTH_USERNAME=replace-me
# Keep the hash single-quoted: Compose must not interpolate its dollar signs.
AUTH_PASSWORD_HASH='pbkdf2_sha256$600000$replace-me$replace-me'
TRANSLATION_PORT=8001
MODEL_DIRECTORY=./models
# Optional comma-separated browser origins, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=
